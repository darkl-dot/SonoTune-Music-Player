{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonoTune",
  "version": "1.1.0",
  "identifier": "app.sonotune.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SonoTune",
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundColor": "#f7f5fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/artwork/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../public/demo/": "demo/" },
    "shortDescription": "Музыка рядом",
    "category": "Music",
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["Russian"] } }
  }
}
